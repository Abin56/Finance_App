<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play Store distribution flavor overlay. Merged over src/main + every
         plugin's library manifest for every build type of the `play` flavor
         (playDebug, playProfile, playRelease).

         Google Play restricts the SMS permission group to apps that are the
         user's default SMS handler. A finance app that parses transaction texts
         is not an approved use case, and exception requests for "SMS banking
         transaction features" are denied on the grounds that SMS access is not
         core functionality for a non-default-handler. Shipping READ_SMS risks
         the entire listing, not just the SMS Inbox feature.

         node="remove" is declared here (rather than by editing src/main) because
         flutter_sms_inbox contributes READ_SMS from its own library manifest —
         deleting the line in src/main would not be enough to keep it out of the
         merged manifest. The app manifest wins the merge, so this does.

         Build with the "play" flavor (see RELEASE.md for the exact command;
         not written out here because a literal double-hyphen CLI flag inside
         an XML comment is invalid XML and fails the manifest merger). See
         PLAY_STORE.md, section "SMS Inbox and the Play build". -->
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="remove" />

    <!-- Same policy rationale as READ_SMS above, applied to the notification-
         listener service declared in src/main/AndroidManifest.xml: Play
         scrutinizes BIND_NOTIFICATION_LISTENER_SERVICE the same way it
         scrutinizes SMS access for an app that isn't the default handler.
         See PLAY_STORE.md > "SMS Inbox and the Play build". -->
    <application>
        <service
            android:name="com.example.finance_app.NotificationCaptureListenerService"
            tools:node="remove" />
    </application>

</manifest>
